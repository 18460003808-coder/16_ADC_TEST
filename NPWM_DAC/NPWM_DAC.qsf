set_global_assignment -name LAST_QUARTUS_VERSION 13.1
set_global_assignment -name VERILOG_FILE rtl/npwm_dac.v
set_global_assignment -name SDC_FILE NPWM_DAC.sdc

# 板卡原理图和引脚对应关系未在需求中给出，因此暂不分配物理引脚。

