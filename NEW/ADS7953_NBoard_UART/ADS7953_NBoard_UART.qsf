set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE30F23C8
set_global_assignment -name TOP_LEVEL_ENTITY ads7953_Nboard_hw_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_INPUT_VERSION VERILOG_2001
set_global_assignment -name VERILOG_FILE rtl/ads7953_16ch_reader.v
set_global_assignment -name VERILOG_FILE rtl/uart_8n1.v
set_global_assignment -name VERILOG_FILE rtl/ads7953_Nboard_controller.v
set_global_assignment -name VERILOG_FILE rtl/ads7953_Nboard_uart_bridge.v
set_global_assignment -name VERILOG_FILE rtl/ads7953_Nboard_top.v
set_global_assignment -name VERILOG_FILE rtl/ads7953_Nboard_hw_top.v
set_global_assignment -name SDC_FILE constraints/timing.sdc
source constraints/pins.qsf
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name ENABLE_CONFIGURATION_PINS OFF

set_global_assignment -name LAST_QUARTUS_VERSION 13.1
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "2.5 V"
set_location_assignment PIN_F17 -to adc_cs_n[1]
set_location_assignment PIN_H20 -to adc_cs_n[2]
set_location_assignment PIN_K21 -to adc_cs_n[3]
set_location_assignment PIN_F20 -to adc_cs_n[5]
set_location_assignment PIN_C20 -to adc_cs_n[4]
set_location_assignment PIN_J18 -to adc_cs_n[10]
set_location_assignment PIN_M21 -to adc_cs_n[15]
set_location_assignment PIN_H22 -to adc_cs_n[6]
set_location_assignment PIN_M19 -to adc_cs_n[11]
set_location_assignment PIN_L21 -to adc_cs_n[7]
set_location_assignment PIN_E21 -to adc_cs_n[16]
set_location_assignment PIN_C22 -to adc_cs_n[8]
set_location_assignment PIN_F22 -to adc_cs_n[9]
set_location_assignment PIN_D21 -to adc_cs_n[12]
set_location_assignment PIN_H18 -to adc_cs_n[17]
set_location_assignment PIN_K18 -to adc_cs_n[18]
set_location_assignment PIN_M22 -to adc_cs_n[19]
set_location_assignment PIN_J22 -to adc_cs_n[14]
set_location_assignment PIN_G18 -to adc_cs_n[13]
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top