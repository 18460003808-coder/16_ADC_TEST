set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE40F23C8
set_global_assignment -name TOP_LEVEL_ENTITY ads7953_Nboard_hw_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_INPUT_VERSION VERILOG_2001

set_global_assignment -name VERILOG_FILE rtl/ads7953_16ch_reader.v
set_global_assignment -name VERILOG_FILE rtl/uart_8n1.v
set_global_assignment -name VERILOG_FILE rtl/ads7953_Nboard_controller.v
set_global_assignment -name VERILOG_FILE rtl/ads7953_Nboard_uart_bridge.v
set_global_assignment -name VERILOG_FILE rtl/ads7953_Nboard_top.v
set_global_assignment -name VERILOG_FILE rtl/ads7953_Nboard_hw_top.v
set_global_assignment -name SDC_FILE constraints/ads7953_Nboard.sdc
source constraints/ads7953_Nboard_pins.qsf

set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name ENABLE_CONFIGURATION_PINS OFF

set_global_assignment -name LAST_QUARTUS_VERSION 13.1
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "2.5 V"
set_location_assignment PIN_H19 -to adc_sdi
set_location_assignment PIN_G17 -to adc_sdo

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top